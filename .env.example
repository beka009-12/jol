# Server-side and /backend rewrite target. Read at build time by next.config.ts.
BACKEND_URL=http://15.134.34.67/

# true: catalog (places, tours, seasons, quote, requests) comes from lib/mocks.
NEXT_PUBLIC_USE_MOCKS=true

# Web OAuth client id; must be the audience the backend accepts for id_token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Som per 1 USD for the "~$" hint in prices.
NEXT_PUBLIC_KGS_PER_USD=87.5
